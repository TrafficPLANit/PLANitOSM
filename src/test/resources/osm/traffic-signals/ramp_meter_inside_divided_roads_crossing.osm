<?xml version="1.0" encoding="UTF-8"?>
<!-- Two divided roads crossing, about 15 m between the carriageways, as in divided_roads_crossing.osm, with a ramp
     meter on shape node 5 of the southbound way 10 (11-1-5-3-12), halfway between its crossing nodes 1 and 3: one-way
     ways 10 and 11 (13-4-2-14, northbound) are crossed by one-way ways 12 (15-2-1-16, westbound) and 13 (17-3-4-18,
     eastbound) at nodes 1 to 4; a traffic signal on each of the four crossing nodes; all primary -->
<osm version="0.6" generator="hand-made for PLANitOSM traffic signal tests">
  <node id="1" lat="-33.87" lon="151.21">
    <tag k="highway" v="traffic_signals"/>
  </node>
  <node id="2" lat="-33.87" lon="151.210162">
    <tag k="highway" v="traffic_signals"/>
  </node>
  <node id="3" lat="-33.870135" lon="151.21">
    <tag k="highway" v="traffic_signals"/>
  </node>
  <node id="4" lat="-33.870135" lon="151.210162">
    <tag k="highway" v="traffic_signals"/>
  </node>
  <node id="5" lat="-33.8700675" lon="151.21">
    <tag k="highway" v="traffic_signals"/>
    <tag k="traffic_signals" v="ramp_meter"/>
  </node>
  <node id="11" lat="-33.8692" lon="151.21"/>
  <node id="12" lat="-33.870935" lon="151.21"/>
  <node id="13" lat="-33.870935" lon="151.210162"/>
  <node id="14" lat="-33.8692" lon="151.210162"/>
  <node id="15" lat="-33.87" lon="151.21113"/>
  <node id="16" lat="-33.87" lon="151.20903"/>
  <node id="17" lat="-33.870135" lon="151.20903"/>
  <node id="18" lat="-33.870135" lon="151.21113"/>
  <way id="10">
    <nd ref="11"/><nd ref="1"/><nd ref="5"/><nd ref="3"/><nd ref="12"/>
    <tag k="highway" v="primary"/>
    <tag k="oneway" v="yes"/>
  </way>
  <way id="11">
    <nd ref="13"/><nd ref="4"/><nd ref="2"/><nd ref="14"/>
    <tag k="highway" v="primary"/>
    <tag k="oneway" v="yes"/>
  </way>
  <way id="12">
    <nd ref="15"/><nd ref="2"/><nd ref="1"/><nd ref="16"/>
    <tag k="highway" v="primary"/>
    <tag k="oneway" v="yes"/>
  </way>
  <way id="13">
    <nd ref="17"/><nd ref="3"/><nd ref="4"/><nd ref="18"/>
    <tag k="highway" v="primary"/>
    <tag k="oneway" v="yes"/>
  </way>
</osm>
