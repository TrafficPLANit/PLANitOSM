<?xml version="1.0" encoding="UTF-8"?>
<!-- Ramp meter on node 2 of one-way motorway on-ramp 1-2-3, about 150 m from either end, where footway crossing 4-2-5
     crosses the ramp; the footway tagged crossing=traffic_signals; no junction anywhere -->
<osm version="0.6" generator="hand-made for PLANitOSM traffic signal tests">
  <node id="1" lat="-33.8700" lon="151.2084"/>
  <node id="2" lat="-33.8700" lon="151.2100">
    <tag k="highway" v="traffic_signals"/>
    <tag k="traffic_signals" v="ramp_meter"/>
  </node>
  <node id="3" lat="-33.8700" lon="151.2116"/>
  <node id="4" lat="-33.8691" lon="151.2100"/>
  <node id="5" lat="-33.8709" lon="151.2100"/>
  <way id="10">
    <nd ref="1"/><nd ref="2"/><nd ref="3"/>
    <tag k="highway" v="motorway_link"/>
    <tag k="oneway" v="yes"/>
  </way>
  <way id="11">
    <nd ref="4"/><nd ref="2"/><nd ref="5"/>
    <tag k="highway" v="footway"/>
    <tag k="footway" v="crossing"/>
    <tag k="crossing" v="traffic_signals"/>
  </way>
</osm>
