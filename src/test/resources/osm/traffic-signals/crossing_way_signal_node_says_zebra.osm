<?xml version="1.0" encoding="UTF-8"?>
<!-- Signalised pedestrian crossing tagged on the crossing way while its node says otherwise: two-way primary road
     2-1-3 crossed at node 1 by footway crossing 4-1-5, the footway tagged crossing=traffic_signals, node 1
     crossing=zebra -->
<osm version="0.6" generator="hand-made for PLANitOSM traffic signal tests">
  <node id="1" lat="-33.8700" lon="151.2100">
    <tag k="highway" v="crossing"/>
    <tag k="crossing" v="zebra"/>
  </node>
  <node id="2" lat="-33.8700" lon="151.2089"/>
  <node id="3" lat="-33.8700" lon="151.2111"/>
  <node id="4" lat="-33.8691" lon="151.2100"/>
  <node id="5" lat="-33.8709" lon="151.2100"/>
  <way id="10">
    <nd ref="2"/><nd ref="1"/><nd ref="3"/>
    <tag k="highway" v="primary"/>
  </way>
  <way id="11">
    <nd ref="4"/><nd ref="1"/><nd ref="5"/>
    <tag k="highway" v="footway"/>
    <tag k="footway" v="crossing"/>
    <tag k="crossing" v="traffic_signals"/>
  </way>
</osm>
