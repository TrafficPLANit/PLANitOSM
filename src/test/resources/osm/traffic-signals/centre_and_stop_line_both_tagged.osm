<?xml version="1.0" encoding="UTF-8"?>
<!-- Four-arm junction at node 1, carrying a vehicle signal, where ways 10 (2-21-1-3) and 11 (4-1-5) cross; the west
     arm also has a vehicle signal on shape node 21, about 15 m before node 1, tagged forward; all primary, two-way -->
<osm version="0.6" generator="hand-made for PLANitOSM traffic signal tests">
  <node id="1" lat="-33.8700" lon="151.2100">
    <tag k="highway" v="traffic_signals"/>
  </node>
  <node id="2" lat="-33.8700" lon="151.2089"/>
  <node id="3" lat="-33.8700" lon="151.2111"/>
  <node id="4" lat="-33.8691" lon="151.2100"/>
  <node id="5" lat="-33.8709" lon="151.2100"/>
  <node id="21" lat="-33.8700" lon="151.209838">
    <tag k="highway" v="traffic_signals"/>
    <tag k="traffic_signals:direction" v="forward"/>
  </node>
  <way id="10">
    <nd ref="2"/><nd ref="21"/><nd ref="1"/><nd ref="3"/>
    <tag k="highway" v="primary"/>
  </way>
  <way id="11">
    <nd ref="4"/><nd ref="1"/><nd ref="5"/>
    <tag k="highway" v="primary"/>
  </way>
</osm>
